run = "pnpm install && (pnpm run dev:api &) && bash -lc 'pnpm --filter @aee/web exec vite --host 0.0.0.0 --port 5000'"
entrypoint = "apps/api/src/index.ts"

[env]
PORT = "8080"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[[ports]]
localPort = 8080
externalPort = 8081

[nix]
channel = "stable-24_05"
packages = ["nodejs_20", "nodePackages.pnpm"]

# Critical Blocker Remediation, Phase 9 — production-mode pilot deployment
# readiness (docs/gate-evidence/PHASE9_DEPLOYMENT_READINESS_AUDIT.md,
# docs/REPLIT_PILOT_DEPLOYMENT_RUNBOOK.md). This section is configuration
# only: it does not deploy anything by itself, and no deployment has been
# published from this section. A human operator must still explicitly
# publish a deployment from the Replit UI/CLI, and only after the renewed
# Operational Readiness Gate decision (Phase 12) authorises doing so — see
# the runbook's explicit "do not deploy yet" instructions. The run command
# starts the API only; in NODE_ENV=production the API also serves the
# built web frontend directly (apps/api/src/lib/staticWeb.ts), so one
# deployment serves both — see the runbook §1 for why.
[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "pnpm install --frozen-lockfile && pnpm --filter @aee/web run build && pnpm --filter @aee/api run build"]
run = ["sh", "-c", "node apps/api/dist/index.mjs"]

[workflows]

[[workflows.workflow]]
name = "Dev"
mode = "parallel"
author = 48455239

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm dev:api"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -lc 'pnpm --filter @aee/web exec vite --host 0.0.0.0 --port 5000'"

[[workflows.workflow]]
name = "FixConfig"
mode = "sequential"
author = 48455239

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo  | base64 -d > .replit && echo ___VERIFY___ && cat .replit && echo ___END___"
