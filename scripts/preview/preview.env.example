# AE Minimal A Owner preview — NEW isolated Repl only. Mock/placeholder values.
# Put these in the preview Repl's Secrets pane (not in a committed file).
# DATABASE_URL comes from the preview Repl's OWN Replit PostgreSQL (auto-set).
NODE_ENV=development
PORT=8080
SESSION_SECRET=<generate: openssl rand -hex 32>   # unique to the preview Repl
AE_MINIMAL_UX_ENABLED=true
AE_MINIMAL_UX_ALLOWLIST=owner.preview@demo.invalid,agent.preview@demo.invalid
# Auth: password login only. Dev-login/known-users stay OFF on a public URL.
ALLOW_DEV_AUTH=false
# AI: mock provider (outputs labelled mock); no keys set.
AI_PROVIDER=mock
LIVE_AI_PROVIDER_APPROVED=false
# Calling / telephony / transcription / comms off
LIVE_TELEPHONY_APPROVED=false
LIVE_CALL_TRANSCRIPTION_APPROVED=false
LIVE_VOICE_TRANSCRIPTION_APPROVED=false
LIVE_COMMUNICATIONS_APPROVED=false
LIVE_EXTERNAL_TRANSACTIONS_APPROVED=false
# Google Places off: leave GOOGLE_PLACES_API_KEY UNSET (manual addresses only)
# Pit Crew flags off
PIT_CREW_LAUNCH_ITEM_SOURCE_ENABLED=false
PIT_CREW_RESPONSIBILITY_ACTIONS_ENABLED=false
# Background sweeps / alerts off
GROW_SIGNAL_SWEEP_ENABLED=false
OPERATIONAL_ALERTS_ENABLED=false
# Payments, billing, AML, e-sign, storage, property data: left UNSET -> non-production sandbox/mock defaults; webhooks off
AML_WEBHOOKS_ENABLED=false
MANDATE_PAYMENT_WEBHOOKS_ENABLED=false
AUTH_EMAIL_PROVIDER=sandbox_auth_email
LAUNCH_TIMEZONE=Australia/Brisbane
TRUST_PROXY=1
