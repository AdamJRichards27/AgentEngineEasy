{
  "name": "@aee/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.mjs --packages=external",
    "start": "node dist/index.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aee/db": "workspace:*",
    "@aee/events": "workspace:*",
    "@aee/integration-property-data": "workspace:*",
    "@aee/integration-aml": "workspace:*",
    "@aee/integration-esign": "workspace:*",
    "@aee/integration-payments": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^22.10.0",
    "tsx": "^4.21.0",
    "esbuild": "^0.27.0"
  }
}
