{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    // apps/* are terminal, bundled build targets, never consumed as
    // libraries by another TS package — composite/declaration output is
    // for packages/* only (see apps/api/tsconfig.json for the same note).
    "composite": false,
    "declaration": false
  },
  "include": ["src"],
  // Node-runner unit tests (tsx --test, see package.json's "test" script)
  // import "node:test"/"node:assert/strict". Rather than adding Node's
  // global ambient types to this browser bundle's program (risking
  // conflicts with DOM lib globals for no benefit to the app itself),
  // test files are excluded from the typechecked program, the same way
  // packages/integrations/object-storage keeps its test files outside its
  // tsc rootDir. tsx transpiles and runs these files directly and does not
  // consult this config, so test execution is unaffected.
  "exclude": ["src/**/__tests__/**"]
}
