# AgentEngineEasy — environment variables (example only; real values never committed)
# This app uses its own database, auth application and provider credentials —
# entirely separate from AgentEngineStaging's.

# Database (own instance — do not point at AgentEngineStaging's database)
DATABASE_URL=

# Auth (own Clerk application, or equivalent — do not reuse AgentEngineStaging's)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Property data
GOOGLE_PLACES_API_KEY=
PROPERTY_DATA_PROVIDER=mock          # mock | google-places | pricefinder

# AML
AML_PROVIDER=mock                    # mock | http (see packages/integrations/aml — HttpAMLProvider; vendor TBD)
AML_API_BASE_URL=
AML_PROVIDER_API_KEY=
AML_WEBHOOK_SECRET=
# Placeholder AML service pricing (Section 11) — real figures pending a
# vendor contract; actual charging is Phase 6.
AML_WHOLESALE_COST_CENTS=1500
AML_CUSTOMER_PRICE_CENTS=2500

# E-signature
ESIGN_PROVIDER=mock                  # mock | http (see packages/integrations/esign — HttpESignProvider; vendor TBD)
ESIGN_API_BASE_URL=
ESIGN_PROVIDER_API_KEY=
ESIGN_WEBHOOK_SECRET=

# Object storage (generated/completed document content — Phase 5)
OBJECT_STORAGE_PROVIDER=local        # local | (a real S3/GCS-equivalent adapter, when added)
OBJECT_STORAGE_LOCAL_DIR=./storage

# Payments
PAYMENT_PROVIDER=mock                # mock | stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# API
PORT=8080
