# AgentEngineEasy — environment variables (example only; real values never committed)
# This app uses its own database, auth application and provider credentials —
# entirely separate from AgentEngineStaging's.

# Database (own instance — do not point at AgentEngineStaging's database)
DATABASE_URL=

# Critical Blocker Remediation, Phase 10 — commercial/external-action lock
# (apps/api/src/lib/env.ts's mustForceMockExternalProvider(), repeated
# locally in each packages/integrations/{payments,aml,esign,property-data}
# provider factory and in apps/api/src/lib/billing/gateway.ts). While this
# is unset (or anything other than the literal string "true") in
# NODE_ENV=production, every one of those factories is HARD-LOCKED to its
# mock/sandbox implementation — a real credential being present elsewhere in
# this file (e.g. STRIPE_SECRET_KEY) is not by itself enough to reach a real
# provider. Leave this unset for every pilot deployment under the AE Project
# Owner's explicit "no real ... transaction authorised" instruction for this
# remediation pass — see docs/gate-evidence/PHASE10_BILLING_AND_EXTERNAL_ACTION_LOCKS.md.
# Outside production this flag has no effect.
LIVE_EXTERNAL_TRANSACTIONS_APPROVED=

# Auth (own Clerk application, or equivalent — do not reuse AgentEngineStaging's)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Staging-only sign-in (apps/api/src/lib/session.ts, routes/auth.ts) — signs
# the session cookie until real Clerk verification replaces it. Required: a
# random string of at least 32 characters (e.g. `openssl rand -base64 48`).
# There is no insecure fallback — session.ts throws unconditionally and the
# API refuses to boot if this is unset or too short, so a missing value
# fails loudly at startup rather than quietly signing forgeable cookies.
SESSION_SECRET=

# Property data
GOOGLE_PLACES_API_KEY=
PROPERTY_DATA_PROVIDER=mock          # mock | google-places | pricefinder

# AML
AML_PROVIDER=mock                    # mock | http (see packages/integrations/aml — HttpAMLProvider; vendor TBD)
AML_API_BASE_URL=
AML_PROVIDER_API_KEY=
# Callback ingress is disabled unless explicitly enabled and a secret is supplied
# through the deployment secret manager. Signature verification is not proof of
# durable byte ingestion, checksum verification, or artifact/version provenance.
AML_WEBHOOKS_ENABLED=false
AML_WEBHOOK_SECRET=
# Placeholder AML service pricing (Section 11) — real figures pending a
# vendor contract; actual charging is Phase 6.
AML_WHOLESALE_COST_CENTS=1500
AML_CUSTOMER_PRICE_CENTS=2500

# E-signature. Mock callbacks are HMAC-authenticated in development/test and
# disabled in production unless a fully configured HTTP provider is explicitly
# approved. Use a dedicated secret of at least 32 characters.
ESIGN_PROVIDER=mock                  # mock | http (see packages/integrations/esign — HttpESignProvider; vendor TBD)
ESIGN_API_BASE_URL=
ESIGN_PROVIDER_API_KEY=
ESIGN_WEBHOOK_SECRET=

# Object storage (generated/completed document content — Phase 5)
# Local disk is development/test only. Production must use a durable
# S3-compatible private bucket, with credentials and signing secrets supplied
# through the environment/secret manager. See
# docs/DURABLE_DOCUMENT_STORAGE_OPERATOR_GUIDE.md.
OBJECT_STORAGE_PROVIDER=local        # local (development/test) | s3 (required in production)
OBJECT_STORAGE_LOCAL_DIR=./storage
OBJECT_STORAGE_LOCAL_SIGNING_SECRET=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_PREFIX=
OBJECT_STORAGE_ENDPOINT=             # HTTPS is required for s3
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_SESSION_TOKEN=
OBJECT_STORAGE_SERVER_SIDE_ENCRYPTION=AES256  # AES256 | aws:kms
OBJECT_STORAGE_KMS_KEY_ID=
DOCUMENT_STORAGE_MAX_BYTES=10485760
DOCUMENT_STORAGE_ESIGN_MAX_DOCUMENT_BYTES=2097152
DOCUMENT_STORAGE_ESIGN_MAX_DOCUMENTS=5
DOCUMENT_STORAGE_PENDING_RECONCILE_AFTER_SECONDS=300
DOCUMENT_STORAGE_PENDING_QUARANTINE_AFTER_SECONDS=86400
DOCUMENT_STORAGE_PENDING_RECONCILE_BATCH_SIZE=50
DOCUMENT_STORAGE_PENDING_RECONCILE_INTERVAL_SECONDS=300
DOCUMENT_STORAGE_SIGNED_DOWNLOAD_SECONDS=300
DOCUMENT_STORAGE_SIGNING_SECRET=
DOCUMENT_STORAGE_RETENTION_CLASSES=legal-pending,transaction,signed-agreement,general
# Named application retention class for Step 3 telephony recording metadata.
# legal-pending is a review label, not a legal retention period.
TELEPHONY_RECORDING_RETENTION_CLASS=legal-pending
OBJECT_STORAGE_SCHEDULER_CONTRACT=

# Production backup/restore and KMS contract (apps/api/src/ops/backup/config.ts).
# The backup runner, not normal API startup, consumes these. Populate only in a
# protected deployment configuration after durable storage, a dedicated
# disposable restore environment, encryption, and scheduling have been approved.
# Commands are JSON string arrays and must retain the documented placeholders
# ({input}, {output}, {kmsProfile}, {source}, {destination}, {object},
# {operation}, {error}); leave blank here rather than committing commands or credentials.
BACKUP_ENVIRONMENT=
BACKUP_DESTINATION=
BACKUP_DOCUMENT_DIRECTORY=
BACKUP_STAGING_DIRECTORY=
BACKUP_RETENTION_DAYS=
BACKUP_ENCRYPTION_AUTHENTICATED=
BACKUP_ENCRYPTION_KMS_PROFILE=
BACKUP_RESTORE_DISPOSABLE=
BACKUP_RESTORE_ENVIRONMENT_ID=
BACKUP_RESTORE_ROOT=
BACKUP_RESTORE_DOCUMENT_DIRECTORY=
BACKUP_RESTORE_DATABASE_URL=
BACKUP_ENCRYPT_COMMAND=
BACKUP_DECRYPT_COMMAND=
BACKUP_UPLOAD_COMMAND=
BACKUP_DOWNLOAD_COMMAND=
# Optional (Package B, local/unpublished): separate read-only verifier and restricted restore download commands.
# Unset = BACKUP_DOWNLOAD_COMMAND is used. Same {source}/{destination} placeholders. Put identity selection (e.g. a profile) in the command array.
BACKUP_VERIFY_DOWNLOAD_COMMAND=
BACKUP_RESTORE_DOWNLOAD_COMMAND=
BACKUP_LIST_COMMAND=
BACKUP_DELETE_COMMAND=
BACKUP_ALERT_COMMAND=
# Tiered retention (Package A). Backups are written to <destination>/daily/, /weekly/ and /monthly/.
# Defaults shown; "keep" = newest recoverable backups never pruned, "days" = minimum age before pruning.
# BACKUP_MIN_RETAINED_COUNT (default 7) is the floor for legacy flat (pre-tier) backups only.
BACKUP_TIER_DAILY_KEEP=7
BACKUP_TIER_DAILY_DAYS=14
BACKUP_TIER_WEEKLY_KEEP=4
BACKUP_TIER_WEEKLY_DAYS=35
BACKUP_TIER_MONTHLY_KEEP=12
BACKUP_TIER_MONTHLY_DAYS=395
# BACKUP_PRUNE: "on" or "off" (exactly). Blank behaves as "on" in this build; confirm the owner-approved
# default before enabling. Pruning needs list + delete rights and is refused when BACKUP_VAULT_MODE=true.
BACKUP_PRUNE=
# BACKUP_VAULT_MODE: "true" or "false". true = write-once vault; requires BACKUP_PRUNE=off or the run is refused.
BACKUP_VAULT_MODE=
# Restore: backups written after tiering are restored with --tier=daily|weekly|monthly
#   pnpm --filter @aee/api backup:restore -- --artifact=<name> --tier=weekly --confirm-disposable
# Omit --tier only for legacy flat backups written before tiering.
# BACKUP_LIST_COMMAND must print a JSON array of {"key","lastModified"} with keys RELATIVE to
# BACKUP_DESTINATION (e.g. "daily/aee-protected-...tar.enc"); see docs/BACKUP_AND_RESTORE_RUNBOOK.md.
# Scheduler operator contract: identify the external scheduler, its cadence,
# alert destination, and the latest successful restore-drill evidence. These
# placeholders are documentation/deployment contract fields; no scheduler is
# implied or enabled by this example file.
BACKUP_SCHEDULER_ENABLED=
BACKUP_SCHEDULER_ID=
BACKUP_SCHEDULE=
BACKUP_RESTORE_DRILL_SCHEDULE=
BACKUP_RESTORE_DRILL_EVIDENCE_URI=

# Payments
PAYMENT_PROVIDER=mock                # mock | stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Overridable Stripe API host (see packages/integrations/payments —
# StripePaymentProvider); defaults to https://api.stripe.com. Only useful
# for pointing at a local fake-Stripe server in testing.
STRIPE_API_BASE_URL=
# Mandate/payment webhook ingress remains sandbox-only unless an external
# provider and its operational controls are separately approved.
MANDATE_PAYMENT_PROVIDER=sandbox
MANDATE_PAYMENT_WEBHOOKS_ENABLED=false
MANDATE_PAYMENT_WEBHOOK_SECRET=

# Billing (Grow subscription checkout — apps/api/src/lib/billing/gateway.ts;
# a SEPARATE Stripe API surface from the one-off Payments block above, but
# the same account/keys — see packages/integrations/billing's own header
# comment). Previously undocumented here even though the code has read it
# since Phase 10 of the original build — added as part of Critical Blocker
# Remediation Phase 10's billing/external-action audit.
BILLING_PROVIDER=mock                # mock | stripe (locked to mock in production unless LIVE_EXTERNAL_TRANSACTIONS_APPROVED=true — see above)

# API
PORT=8080
# Explicit CORS allowlist (apps/api/src/lib/cors.ts) — comma-separated
# origins allowed to make credentialed cross-origin requests (the frontend
# always calls with credentials: "include", see apps/web's lib/api.ts).
# Outside production, an unset value falls back to common localhost dev
# origins (http://localhost:5173, http://localhost:3000) so local dev
# isn't broken. In production this MUST be set explicitly — the API
# refuses to boot otherwise (see assertCorsConfigured() in
# apps/api/src/index.ts) rather than falling back to reflecting any
# requesting Origin.
CORS_ALLOWED_ORIGINS=

# Operational alerts. Production startup requires a selected, authenticated
# HTTPS webhook receiver; leave values blank in local development to keep
# alert delivery disabled. Do not put real values in this example file.
OPERATIONAL_ALERTS_ENABLED=
OPERATIONAL_ALERTS_PROVIDER=webhook
OPERATIONAL_ALERTS_WEBHOOK_URL=
OPERATIONAL_ALERTS_TOKEN=
# Optional in-process cooldown (1-86400 seconds; defaults to 300).
OPERATIONAL_ALERTS_COOLDOWN_SECONDS=300
# Test dispatch has no route and requires this separate explicit opt-in.
OPERATIONAL_ALERTS_ALLOW_TEST=false

# ---------------------------------------------------------------------------
# AE GROW brokerage-wide Signal Sweep (background job)
# ---------------------------------------------------------------------------
# The scheduled job that evaluates every brokerage's Property Intelligence
# signals. Read by apps/api/src/lib/propertyIntelligence/sweep.ts's
# sweepConfig(); started by sweepBootstrap.ts's registerSignalSweep() at boot.
# Every knob below is OPTIONAL — an absent or invalid value keeps the
# documented default, and an invalid value is never read as "unlimited".
#
# Operability: GET /api/grow/property-intelligence/ops/health reports the
# effective values of these settings together with last-run/staleness state,
# so a misconfiguration is visible over HTTP rather than only in a boot log
# line. That endpoint, and POST .../ops/sweep (manual trigger), are Brokerage
# Administrator only.
#
# THE HARD OFF SWITCH. Exactly "false" stops the scheduler starting; because
# sweepBootstrap.ts is the only production caller, no sweep runs at all. An
# explicit runSignalSweep() call — the ops endpoint and tests — still works.
# Any other value (including unset) leaves the sweep ENABLED. When this is
# false, ops/health reports scheduler.enabled=false, which is what
# distinguishes "deliberately switched off" from "switched on and broken".
GROW_SIGNAL_SWEEP_ENABLED=
# Scheduler period in milliseconds. Default 1800000 (30 minutes). Also sets
# the staleness threshold the ops health endpoint reports: 3 x this value.
GROW_SIGNAL_SWEEP_INTERVAL_MS=
# Ceiling on brokerages evaluated in ONE run. Default 200. A run that hits it
# stops cleanly; the next run resumes with whatever is now most overdue
# (the resume point lives in grow_signal_sweep_cursors, not in the process).
GROW_SIGNAL_SWEEP_MAX_BROKERAGES=
# Ceiling on candidates evaluated for ONE brokerage. Default 5000. Hitting it
# marks the run `truncated` and suppresses that brokerage's "no longer
# supported -> Expired" pass, because a truncated candidate set is not
# authoritative.
GROW_SIGNAL_SWEEP_MAX_CANDIDATES=
# Force a full evaluation of a brokerage at least this often even when change
# detection says nothing moved. Default 86400000 (24 hours). This is what
# catches the one kind of change no source timestamp can express: time itself
# passing, which is what moves a tenure or overdue band.
GROW_SIGNAL_SWEEP_FULL_INTERVAL_MS=

# ---------------------------------------------------------------------------
# Pit Crew WAITING_ON detection sweep (background job) — DEFAULT OFF
# ---------------------------------------------------------------------------
# Opt-in scheduler that identifies, classifies, sorts, and logs overdue
# WAITING_ON Pit Crew items. It does not return them to IN_PROGRESS, reassign
# them, or contact clients or third parties. Read by
# pitCrewWaitingOnSweepConfig() in
# apps/api/src/lib/pitCrew/waitingOnSweepBootstrap.ts and started by
# registerPitCrewWaitingOnSweep() at boot. Commented out on purpose: enabling
# it is an Owner/ops decision, and a separate post-merge step. This file
# does not turn it on.
#
# THE HARD ON SWITCH. Only the literal string "true" starts the scheduler.
# Unset, empty, "false", "TRUE", "1", or any other value leaves it OFF.
# When it is off, boot logs pit_crew_waiting_on_sweep_scheduler_disabled and
# no timer is armed. The human POST /pit-crew/ops/waiting-on/sweep route is
# unaffected and still returns overdue rows to IN_PROGRESS.
# PIT_CREW_WAITING_ON_SWEEP_ENABLED=true
#
# Process wake in milliseconds. Default 1800000 (30 minutes), matching the
# per-brokerage cadence default. Values below 60000 clamp up to 60000; values
# above 86400000 (24 hours) clamp down to 86400000. A non-numeric value falls
# back to 1800000 and logs a warning. It is never read as unlimited or as
# zero. A brokerage cadence shorter than this wake cannot run more often than
# the wake. Cadence, operating window, and tier thresholds are per brokerage
# on pit_crew_waiting_on_sweep_settings (see that table). Defaults when no
# row exists: cadence 30 minutes, Mon–Fri 08:00–18:00 local, tiers at 2h and 4h.
# PIT_CREW_WAITING_ON_SWEEP_INTERVAL_MS=1800000

# ---------------------------------------------------------------------------
# Pit Crew hand-back and escalate routes — DEFAULT OFF
# ---------------------------------------------------------------------------
# POST hand-back, escalate, escalation acknowledge/resolve/return, and
# hand-back reclaim. Read by isPitCrewResponsibilityActionsEnabled() in
# apps/api/src/lib/pitCrew/responsibility.ts. Commented out on purpose: do
# not set this in a real environment file. Apply migrations 0032 and 0033
# first. While this is off, those six routes respond 404
# { "error": "Not found." } and do not read or write
# pit_crew_responsibility_events.
#
# THE HARD ON SWITCH. Only the literal string "true" enables the routes.
# Unset, empty, "false", "TRUE", "1", or any other value leaves them OFF.
# PIT_CREW_RESPONSIBILITY_ACTIONS_ENABLED=true

# Legal active-artifact control. These are engineering integrity inputs, not
# evidence of legal review or approval. Production rejects missing paths/hashes,
# hash mismatches, and artifacts retaining the DRAFT — LEGAL REVIEW REQUIRED marker.
# Keep blank until an assigned authority has separately approved non-draft artifacts.
LEGAL_DOCUMENTS_APPROVED=
APPROVED_TERMS_ARTIFACT_PATH=
APPROVED_TERMS_SHA256=
APPROVED_PRIVACY_ARTIFACT_PATH=
APPROVED_PRIVACY_SHA256=

# Communications webhook ingress is fail-closed. Both values are required to
# receive callbacks; leave disabled until a secret is provisioned. Signature
# validation alone is not durable byte-ingestion/checksum/version proof.
COMMUNICATIONS_WEBHOOK_INGRESS_ENABLED=false
COMMUNICATIONS_WEBHOOK_SECRET=

# AI (Contextual AI Architecture / Agent Engine Copilot)
# Provider abstraction mirrors AML/e-sign/payments above: mock is the safe default
# everywhere until a real key is supplied via Replit Secrets (never commit the key).
AI_PROVIDER=mock                    # mock | anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-5
AI_TEMPERATURE=0.2
AI_MAX_OUTPUT_TOKENS=1024
AI_TIMEOUT_MS=20000
AI_RETRY_LIMIT=2
AI_FALLBACK_PROVIDER=mock           # provider to use if the primary provider errors
# Master switch + per-role flags (services/ai/featureFlags.ts). All default on for
# Copilot (read-only, Level 0) and off for every role that has no real implementation
# yet (Proactive Intelligence, Business Coach, Workflow AI, Pit Crew AI).
AI_ENABLED=true
AI_COPILOT_ENABLED=true
AI_PROACTIVE_INTELLIGENCE_ENABLED=false
AI_BUSINESS_COACH_ENABLED=false
AI_WORKFLOW_AI_ENABLED=false
AI_PITCREW_AI_ENABLED=false

# AE GROW Priority 6 Stage E — Voice as Input (apps/api/src/lib/ai/voice/*).
# Provider abstraction mirrors the AI block above: mock is the safe default
# everywhere until a real key is supplied via Replit Secrets (never commit
# the key) AND live voice transcription is separately approved below.
AI_TRANSCRIPTION_PROVIDER=mock       # mock | deepgram
# Deepgram pre-recorded transcription API key. Only read when
# AI_TRANSCRIPTION_PROVIDER=deepgram. The endpoint itself is NOT
# configurable here — apps/api/src/lib/ai/voice/deepgramTranscriptionProvider.ts
# hardcodes the fixed Australian (Sydney) endpoint
# (https://api.au.deepgram.com/v1/listen) in server code, and no client
# request or environment variable can change it or route to another region.
DEEPGRAM_API_KEY=
# Bounded request budget for a single transcription call, in milliseconds.
AI_TRANSCRIPTION_TIMEOUT_MS=15000
# Fail-closed live-provider lock, modelled directly on
# LIVE_EXTERNAL_TRANSACTIONS_APPROVED above but kept as its own SEPARATE
# flag (apps/api/src/lib/env.ts's isLiveVoiceTranscriptionApproved() /
# mustForceMockVoiceTranscriptionProvider()): approving payments/AML/
# e-signature/property-data providers is not the same decision as approving
# an external party to receive a user's recorded voice. While this is unset
# (or anything other than the literal string "true") in NODE_ENV=production,
# apps/api/src/lib/ai/voice/gateway.ts refuses to construct a live
# (Deepgram) provider even if AI_TRANSCRIPTION_PROVIDER=deepgram and
# DEEPGRAM_API_KEY are both configured — it throws a typed
# "live_provider_disabled" error rather than silently substituting the mock
# provider. Leave unset until the AE Project Owner has separately approved a
# live transcription provider (see the "Live-activation gates" section of
# docs/AE_GROW_PRIORITY_6_STAGE_E_VOICE_INPUT_REPORT.md).
#
# AE GROW Pilot Readiness WP2a: this lock now applies in EVERY environment —
# mustForceMockVoiceTranscriptionProvider() no longer tests
# isProductionEnvironment(). Previously it was production-only, so a
# development/staging process with AI_TRANSCRIPTION_PROVIDER=deepgram and a
# key sent real recorded voice to Deepgram without this approval.
# Safe default: blank. Required in production: no — leave unset for the pilot.
LIVE_VOICE_TRANSCRIPTION_APPROVED=

# AE GROW Priority 6 Stage F1 — Call Foundation, Consent Model and Sandbox
# Telephony (apps/api/src/lib/telephony/*, routes/growCalls.ts,
# routes/growCallsWebhooks.ts). F1 implements ONLY a sandbox/mock
# telephony provider — SandboxTelephonyProvider makes no external network
# calls, never dials a real number, and never records audio. There is no
# real TelephonyProvider adapter in this codebase yet for the flag below to
# unlock.
#
# Kill switch for a FUTURE real provider, modelled directly on
# LIVE_VOICE_TRANSCRIPTION_APPROVED above but kept as its own SEPARATE flag
# (apps/api/src/lib/env.ts's isLiveTelephonyApproved() /
# mustForceMockTelephonyProvider()) — approving payments/AML/e-signature/
# property-data providers or live voice transcription must never be read as
# approving live telephony. Even once a real provider adapter exists, F2's
# own authorisation requires ALL of: a configured provider selection,
# credentials, an entitlement, AND this flag set to the literal string
# "true" — never this flag alone. Leave unset.
#
# AE GROW Pilot Readiness WP2a: mustForceMockTelephonyProvider() now applies
# in EVERY environment (it no longer tests isProductionEnvironment()), so a
# dev/staging process can never reach a real telephony adapter either.
# Safe default: blank. Required in production: no — leave unset for the pilot.
LIVE_TELEPHONY_APPROVED=

# Sandbox-only telephony webhook ingress (routes/growCallsWebhooks.ts),
# fail-closed exactly like COMMUNICATIONS_WEBHOOK_INGRESS_ENABLED above:
# both values are required to receive a simulated sandbox-provider
# lifecycle event; leave disabled until a secret is provisioned. F1 never
# exposes a live external provider integration here — see §15 of the
# Stage F1 authorisation.
GROW_CALLS_WEBHOOK_INGRESS_ENABLED=false
GROW_CALLS_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# AE GROW Pilot Readiness WP4 — variables this application reads that were
# previously undocumented here. Every entry below names the exact code path
# that reads it. "Required in production" means the API refuses to boot (or
# behaves incorrectly) without it; anything else is optional with the stated
# default already applied in code.
# ---------------------------------------------------------------------------

# Runtime classification (apps/api/src/lib/env.ts isProductionEnvironment()).
# Only the literal string "production" activates the fail-closed gates, the
# static-frontend serving (lib/staticWeb.ts) and the production-only startup
# assertions. Its absence is never treated as production.
# Required in production: YES — must be exactly "production".
NODE_ENV=development

# Structured log threshold (packages/events/src/logger.ts configuredMinLevel()).
# Accepted: debug | info | warn | error. Any other value falls back to "info".
# Required in production: no.
LOG_LEVEL=info

# Built frontend directory for production static serving
# (apps/api/src/lib/staticWeb.ts mountStaticWebIfPresent()). Unset resolves to
# ../../web/dist relative to the built API bundle. If the directory has no
# index.html the API logs static_web_not_present and serves the JSON API only.
# Required in production: no — only if the build layout is non-standard.
WEB_DIST_DIR=

# Absolute base URL used to build invitation and password-reset links
# (apps/api/src/routes/auth.ts frontendBaseUrl()). Unset defaults to
# http://localhost:5173, which makes every generated link useless off a
# developer's machine. No trailing slash.
# Required in production: YES in practice (nothing refuses to boot without it,
# but every issued link is wrong).
FRONTEND_BASE_URL=

# Bearer token guarding GET /api/internal/metrics
# (apps/api/src/lib/metricsAuth.ts; assertMetricsAuthConfigured() is called
# from apps/api/src/index.ts). Any non-empty value is accepted; compared in
# constant time. Outside production an unset token leaves the endpoint open.
# Required in production: YES — the process refuses to start without it.
METRICS_TOKEN=

# Auth email provider selection (apps/api/src/lib/auth/email.ts
# assertAuthEmailProviderConfigured(), called from index.ts). In production the
# process refuses to start unless this names a real provider (any value other
# than "sandbox") OR the acknowledgement flag below is exactly "true". Only the
# sandbox provider is implemented in this build — it performs no real delivery.
# Required in production: YES — this or the acknowledgement flag below.
AUTH_EMAIL_PROVIDER=

# Explicit acknowledgement that production is booting with the sandbox
# (non-delivering) auth-email provider (same module as above). Set to exactly
# "true" to boot; it additionally makes every invitation/reset link be written
# to the structured log as a pilot_mode_sandbox_email_link warning for out-of-
# band hand delivery. Read docs/REPLIT_PILOT_DEPLOYMENT_RUNBOOK.md §5 first.
# Required in production: YES — this or AUTH_EMAIL_PROVIDER above.
PILOT_MODE_SANDBOX_EXTERNAL_SERVICES_ACKNOWLEDGED=

# Development-only sign-in routes POST /auth/dev-login and
# GET /auth/known-users (apps/api/src/lib/env.ts isDevAuthEnabled()). Opens
# only when this is exactly "true" AND NODE_ENV is not "production"; it can
# never be enabled in production by any value.
# Required in production: no — must stay unset/false.
ALLOW_DEV_AUTH=false

# Accepts a session cookie without the Secure attribute, for plain-http local
# development only (apps/api/src/lib/env.ts
# isInsecureCookieExplicitlyAllowed()). Ignored in production.
# Required in production: no — must stay unset/false.
ALLOW_INSECURE_DEV_COOKIES=false

# Database session time zone (packages/db/src/index.ts
# isSessionTimezoneSetEnabled() and packages/db/src/migrate.ts). Every
# timestamp column is `timestamp without time zone` in UTC, so anything the
# DATABASE computes (defaultNow(), now(), interval cut-offs) must evaluate in
# a UTC session. By default every new pool connection runs
# `SET TIME ZONE 'UTC'` in pg-pool's awaited onConnect hook; a connection whose
# SET fails is discarded rather than handed to a caller. Set to the literal
# string "false" ONLY for a connection pooler that rejects or discards session
# SETs — in which case the database/role default must itself be UTC
# (`ALTER DATABASE <db> SET timezone TO 'UTC'`). Any value other than "false"
# keeps the SET on. apps/api/src/lib/dbTimezone.ts verifies the EFFECTIVE
# session time zone at startup and refuses to start in production when it is
# not UTC (warning only elsewhere); it also warns when the session is UTC only
# because of the connect-time SET while the database default is not.
# Required in production: no — leave unset; set the database default to UTC.
DB_SET_SESSION_TIMEZONE=

# Fail-closed lock on a real AI text-generation provider
# (apps/api/src/lib/env.ts isLiveAiProviderApproved() /
# mustForceMockAiProvider(), enforced in apps/api/src/lib/ai/gateway.ts's
# buildProvider()). Selecting AI_PROVIDER/AI_FALLBACK_PROVIDER=anthropic plus
# an ANTHROPIC_API_KEY is NOT enough on its own: unless this is exactly "true",
# buildProvider() returns the mock provider and logs
# ai_provider_not_approved_fallback_to_mock once per process per requested
# provider. Applies in EVERY environment, and is separate from every other
# LIVE_*_APPROVED flag — approving voice, call transcription, telephony or
# external transactions never approves an external LLM.
# Required in production: no — leave unset for the pilot.
LIVE_AI_PROVIDER_APPROVED=

# Fail-closed lock on a real call-transcription provider
# (apps/api/src/lib/env.ts isLiveCallTranscriptionApproved() /
# mustForceMockCallTranscriptionProvider(); enforced in
# apps/api/src/lib/ai/voice/gateway.ts and apps/api/src/lib/telephony/
# callTranscriptions.ts). Applies in EVERY environment, including development
# and test. Independent of LIVE_VOICE_TRANSCRIPTION_APPROVED: permission to
# transcribe a standalone voice note is not permission to send recorded CALL
# audio to a provider. The mock provider stays available without approval.
# Required in production: no — leave unset for the pilot.
LIVE_CALL_TRANSCRIPTION_APPROVED=

# Operational-approval gate in the five-gate call recording conjunction
# (apps/api/src/lib/telephony/recordingGates.ts — LIVE_RECORDING_APPROVAL_ENV;
# the gate passes only when process.env[LIVE_RECORDING_APPROVED] === "true").
# All five gates must pass — entitlement (grow.calling.recording), legal
# policy, consent/disclosure, adapter capability, and this flag — so this flag
# alone never enables recording. Applies in every environment.
# Required in production: no — leave unset for the pilot.
LIVE_RECORDING_APPROVED=

# Optional internal call-summary drafting (apps/api/src/lib/ai/featureFlags.ts
# isGrowCallSummaryEnabled()). Gated by AI_ENABLED as well; defaults to false
# when unset or empty. Parsed case-insensitively against "true".
# Required in production: no.
AI_GROW_CALL_SUMMARY_ENABLED=false

# Optional explicit key for the keyed (v2) tamper hash over an AI action
# request's canonical input payload (apps/api/src/lib/ai/actionRequests.ts
# inputPayloadHmacKey()). Must be at least 32 bytes or the code throws. When
# unset or empty, the key is derived deterministically from SESSION_SECRET
# (already mandatory and >= 32 characters), so this is not a new mandatory
# variable. Rotating whichever secret is in use invalidates the hashes of
# pending action requests — they fail closed as PAYLOAD_TAMPERED and must be
# re-proposed.
# Required in production: no.
AI_ACTION_PAYLOAD_HMAC_KEY=

# Maximum accepted clock skew, in seconds, between an AML webhook's signed
# timestamp and this server (apps/api/src/lib/aml.ts). Defaults to 300 when
# unset. A request outside the tolerance is rejected as stale_timestamp before
# signature verification.
# Required in production: no.
AML_WEBHOOK_TOLERANCE_SECONDS=300

# Call-transcription reconciler tuning
# (apps/api/src/lib/telephony/callTranscriptionReconciliation.ts
# configuredCallTranscriptionReconciliation(); the scheduler that consumes it
# is apps/api/src/lib/telephony/callTranscriptionReconciler.ts). Each value
# must be an integer inside its documented range or the process throws at
# startup — an out-of-range value is not silently clamped.
#   STALE_AFTER_MS       default 900000 (15 min); range 120000 .. 604800000
#   RECONCILE_BATCH_SIZE default 100;             range 1 .. 500
#   RECONCILE_INTERVAL_MS default 300000 (5 min); range 30000 .. 86400000
# Required in production: no — the defaults are the intended pilot values.
CALL_TRANSCRIPTION_STALE_AFTER_MS=900000
CALL_TRANSCRIPTION_RECONCILE_BATCH_SIZE=100
CALL_TRANSCRIPTION_RECONCILE_INTERVAL_MS=300000

# IANA time zone used to compute property-launch task due dates
# (apps/api/src/lib/launch/templates.ts calculateDueDate()). Defaults to
# Australia/Sydney when unset or empty. This is a scheduling convenience only
# — it does not change how timestamps are stored (see DB_SET_SESSION_TIMEZONE).
# Required in production: no.
LAUNCH_TIMEZONE=Australia/Sydney

# Optional cap on the Postgres connection-pool size (pg default: 10 per pool).
# One API process is fine on the default; set this when many processes share a
# database server (e.g. a parallel test run opens one pool per test file and can
# exhaust max_connections, which surfaces as unexpected 401s). Unset or invalid
# values keep the pg default. Read by packages/db/src/index.ts (createSafePool).
PG_POOL_MAX=

# Proxy trust for client-IP detection (rate limiting). Unset/empty/"false"
# trusts no proxy — correct when the API is reached directly. Behind a load
# balancer or reverse proxy (e.g. a Replit deployment) set the number of hops,
# normally TRUST_PROXY=1, or every user shares one rate-limit budget. Never set
# "true" unless every hop is trusted: a client could then spoof X-Forwarded-For
# and bypass rate limiting. Read by apps/api/src/app.ts (parseTrustProxySetting).
TRUST_PROXY=

# Whether the per-tier daily AI request cap is enforced (see
# apps/api/src/lib/ai/dailyUsage.ts). Unset: the cap applies only when a real AI
# provider is approved (LIVE_AI_PROVIDER_APPROVED=true), so the mock provider —
# the pilot default — is never throttled. "true"/"false" always wins. The per-tier
# numbers (TIER_CAPABILITIES.maxAiRequestsPerDay) are per brokerage, not per user,
# and have not been tuned for real use; agree them before enforcing on real spend.
AI_DAILY_CAP_ENFORCED=

# ---------------------------------------------------------------------------
# AI daily usage limits (per user and per brokerage)
# ---------------------------------------------------------------------------
# Two independent daily limits; a request is refused if it would exceed either.
# Both are optional and unset by default, so the mock-provider pilot is never
# throttled (usage is still metered and inspectable via GET /api/ai/usage).
# Accepted values: a positive integer, or off / none / unlimited / disabled.
# Anything else (0, -1, "20/day") is rejected and fails closed rather than
# being read as "unlimited". Read by apps/api/src/lib/ai/usageLimits.ts.
#
# Per-user daily limit (all tiers), with optional per-tier overrides. Unset
# means no per-user limit.
AI_DAILY_LIMIT_PER_USER=
AI_DAILY_LIMIT_PER_USER_STARTER=
AI_DAILY_LIMIT_PER_USER_GROW=
AI_DAILY_LIMIT_PER_USER_PRO=
#
# Brokerage-level daily safety ceiling (all tiers), with optional per-tier
# overrides. Unset falls back to the PROVISIONAL per-tier technical safety
# numbers in lib/ai/entitlements.ts (Starter 20 / Grow 200 / Pro 1000 per
# brokerage per day). Those are not commercial allowances and must be agreed
# before a live AI provider is approved.
AI_DAILY_LIMIT_PER_BROKERAGE=
AI_DAILY_LIMIT_PER_BROKERAGE_STARTER=
AI_DAILY_LIMIT_PER_BROKERAGE_GROW=
AI_DAILY_LIMIT_PER_BROKERAGE_PRO=
#
# When LIVE_AI_PROVIDER_APPROVED=true, BOTH the per-user allowance and the
# brokerage ceiling must be explicitly configured (writing "off" counts as a
# decision). Otherwise the API refuses to start and every AI surface answers
# 503 rather than silently applying the provisional numbers.
#
# Optional C-10 ceilings. Unset means no extra limit, including when a live
# provider is approved — they are NOT part of the boot gate above. Same
# accepted values (positive integer, or off / none / unlimited / disabled).
# There is no dollar ceiling. Estimated cost stays telemetry on GET /api/ai/usage.
#
# Total tokens per UTC day (ai_usage.total_tokens). Per-tier overrides win.
AI_DAILY_TOKEN_LIMIT_PER_USER=
AI_DAILY_TOKEN_LIMIT_PER_USER_STARTER=
AI_DAILY_TOKEN_LIMIT_PER_USER_GROW=
AI_DAILY_TOKEN_LIMIT_PER_USER_PRO=
AI_DAILY_TOKEN_LIMIT_PER_BROKERAGE=
AI_DAILY_TOKEN_LIMIT_PER_BROKERAGE_STARTER=
AI_DAILY_TOKEN_LIMIT_PER_BROKERAGE_GROW=
AI_DAILY_TOKEN_LIMIT_PER_BROKERAGE_PRO=
#
# Provider-reported voice audio seconds per UTC day (audit_logs action
# AI_VOICE_TRANSCRIBED). Voice does not increment the AI request count.
# Enforced on POST /api/ai/voice/transcribe only, and only when the daily
# cap is enforced (AI_DAILY_CAP_ENFORCED / live provider), same as the
# request ceilings.
VOICE_DAILY_AUDIO_SECONDS_PER_USER=
VOICE_DAILY_AUDIO_SECONDS_PER_USER_STARTER=
VOICE_DAILY_AUDIO_SECONDS_PER_USER_GROW=
VOICE_DAILY_AUDIO_SECONDS_PER_USER_PRO=
VOICE_DAILY_AUDIO_SECONDS_PER_BROKERAGE=
VOICE_DAILY_AUDIO_SECONDS_PER_BROKERAGE_STARTER=
VOICE_DAILY_AUDIO_SECONDS_PER_BROKERAGE_GROW=
VOICE_DAILY_AUDIO_SECONDS_PER_BROKERAGE_PRO=
