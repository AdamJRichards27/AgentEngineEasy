# AgentEngineEasy — environment variables (example only; real values never committed)
# This app uses its own database, auth application and provider credentials —
# entirely separate from AgentEngineStaging's.

# Database (own instance — do not point at AgentEngineStaging's database)
DATABASE_URL=

# Critical Blocker Remediation, Phase 10 — commercial/external-action lock
# (apps/api/src/lib/env.ts's mustForceMockExternalProvider(), repeated
# locally in each packages/integrations/{payments,aml,esign,property-data}
# provider factory and in apps/api/src/lib/billing/gateway.ts). While this
# is unset (or anything other than the literal string "true") in
# NODE_ENV=production, every one of those factories is HARD-LOCKED to its
# mock/sandbox implementation — a real credential being present elsewhere in
# this file (e.g. STRIPE_SECRET_KEY) is not by itself enough to reach a real
# provider. Leave this unset for every pilot deployment under the AE Project
# Owner's explicit "no real ... transaction authorised" instruction for this
# remediation pass — see docs/gate-evidence/PHASE10_BILLING_AND_EXTERNAL_ACTION_LOCKS.md.
# Outside production this flag has no effect.
LIVE_EXTERNAL_TRANSACTIONS_APPROVED=

# Auth (own Clerk application, or equivalent — do not reuse AgentEngineStaging's)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Staging-only sign-in (apps/api/src/lib/session.ts, routes/auth.ts) — signs
# the session cookie until real Clerk verification replaces it. Required: a
# random string of at least 32 characters (e.g. `openssl rand -base64 48`).
# There is no insecure fallback — session.ts throws unconditionally and the
# API refuses to boot if this is unset or too short, so a missing value
# fails loudly at startup rather than quietly signing forgeable cookies.
SESSION_SECRET=

# Property data
GOOGLE_PLACES_API_KEY=
PROPERTY_DATA_PROVIDER=mock          # mock | google-places | pricefinder

# AML
AML_PROVIDER=mock                    # mock | http (see packages/integrations/aml — HttpAMLProvider; vendor TBD)
AML_API_BASE_URL=
AML_PROVIDER_API_KEY=
# Callback ingress is disabled unless explicitly enabled and a secret is supplied
# through the deployment secret manager. Signature verification is not proof of
# durable byte ingestion, checksum verification, or artifact/version provenance.
AML_WEBHOOKS_ENABLED=false
AML_WEBHOOK_SECRET=
# Placeholder AML service pricing (Section 11) — real figures pending a
# vendor contract; actual charging is Phase 6.
AML_WHOLESALE_COST_CENTS=1500
AML_CUSTOMER_PRICE_CENTS=2500

# E-signature
ESIGN_PROVIDER=mock                  # mock | http (see packages/integrations/esign — HttpESignProvider; vendor TBD)
ESIGN_API_BASE_URL=
ESIGN_PROVIDER_API_KEY=
ESIGN_WEBHOOK_SECRET=

# Object storage (generated/completed document content — Phase 5)
# Local disk is development/test only. Production must use a durable
# S3-compatible private bucket, with credentials and signing secrets supplied
# through the environment/secret manager. See
# docs/DURABLE_DOCUMENT_STORAGE_OPERATOR_GUIDE.md.
OBJECT_STORAGE_PROVIDER=local        # local (development/test) | s3 (required in production)
OBJECT_STORAGE_LOCAL_DIR=./storage
OBJECT_STORAGE_LOCAL_SIGNING_SECRET=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_PREFIX=
OBJECT_STORAGE_ENDPOINT=             # HTTPS is required for s3
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_SESSION_TOKEN=
OBJECT_STORAGE_SERVER_SIDE_ENCRYPTION=AES256  # AES256 | aws:kms
OBJECT_STORAGE_KMS_KEY_ID=
DOCUMENT_STORAGE_MAX_BYTES=10485760
DOCUMENT_STORAGE_ESIGN_MAX_DOCUMENT_BYTES=2097152
DOCUMENT_STORAGE_ESIGN_MAX_DOCUMENTS=5
DOCUMENT_STORAGE_PENDING_RECONCILE_AFTER_SECONDS=300
DOCUMENT_STORAGE_PENDING_QUARANTINE_AFTER_SECONDS=86400
DOCUMENT_STORAGE_PENDING_RECONCILE_BATCH_SIZE=50
DOCUMENT_STORAGE_PENDING_RECONCILE_INTERVAL_SECONDS=300
DOCUMENT_STORAGE_SIGNED_DOWNLOAD_SECONDS=300
DOCUMENT_STORAGE_SIGNING_SECRET=
DOCUMENT_STORAGE_RETENTION_CLASSES=legal-pending,transaction,signed-agreement,general
OBJECT_STORAGE_SCHEDULER_CONTRACT=

# Production backup/restore and KMS contract (apps/api/src/ops/backup/config.ts).
# The backup runner, not normal API startup, consumes these. Populate only in a
# protected deployment configuration after durable storage, a dedicated
# disposable restore environment, encryption, and scheduling have been approved.
# Commands are JSON string arrays and must retain the documented placeholders
# ({input}, {output}, {kmsProfile}, {source}, {destination}, {object},
# {operation}, {error}); leave blank here rather than committing commands or credentials.
BACKUP_ENVIRONMENT=
BACKUP_DESTINATION=
BACKUP_DOCUMENT_DIRECTORY=
BACKUP_STAGING_DIRECTORY=
BACKUP_RETENTION_DAYS=
BACKUP_ENCRYPTION_AUTHENTICATED=
BACKUP_ENCRYPTION_KMS_PROFILE=
BACKUP_RESTORE_DISPOSABLE=
BACKUP_RESTORE_ENVIRONMENT_ID=
BACKUP_RESTORE_ROOT=
BACKUP_RESTORE_DOCUMENT_DIRECTORY=
BACKUP_RESTORE_DATABASE_URL=
BACKUP_ENCRYPT_COMMAND=
BACKUP_DECRYPT_COMMAND=
BACKUP_UPLOAD_COMMAND=
BACKUP_DOWNLOAD_COMMAND=
BACKUP_LIST_COMMAND=
BACKUP_DELETE_COMMAND=
BACKUP_ALERT_COMMAND=
# Scheduler operator contract: identify the external scheduler, its cadence,
# alert destination, and the latest successful restore-drill evidence. These
# placeholders are documentation/deployment contract fields; no scheduler is
# implied or enabled by this example file.
BACKUP_SCHEDULER_ENABLED=
BACKUP_SCHEDULER_ID=
BACKUP_SCHEDULE=
BACKUP_RESTORE_DRILL_SCHEDULE=
BACKUP_RESTORE_DRILL_EVIDENCE_URI=

# Payments
PAYMENT_PROVIDER=mock                # mock | stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Overridable Stripe API host (see packages/integrations/payments —
# StripePaymentProvider); defaults to https://api.stripe.com. Only useful
# for pointing at a local fake-Stripe server in testing.
STRIPE_API_BASE_URL=
# Mandate/payment webhook ingress remains sandbox-only unless an external
# provider and its operational controls are separately approved.
MANDATE_PAYMENT_PROVIDER=sandbox
MANDATE_PAYMENT_WEBHOOKS_ENABLED=false
MANDATE_PAYMENT_WEBHOOK_SECRET=

# Billing (Grow subscription checkout — apps/api/src/lib/billing/gateway.ts;
# a SEPARATE Stripe API surface from the one-off Payments block above, but
# the same account/keys — see packages/integrations/billing's own header
# comment). Previously undocumented here even though the code has read it
# since Phase 10 of the original build — added as part of Critical Blocker
# Remediation Phase 10's billing/external-action audit.
BILLING_PROVIDER=mock                # mock | stripe (locked to mock in production unless LIVE_EXTERNAL_TRANSACTIONS_APPROVED=true — see above)

# API
PORT=8080
# Explicit CORS allowlist (apps/api/src/lib/cors.ts) — comma-separated
# origins allowed to make credentialed cross-origin requests (the frontend
# always calls with credentials: "include", see apps/web's lib/api.ts).
# Outside production, an unset value falls back to common localhost dev
# origins (http://localhost:5173, http://localhost:3000) so local dev
# isn't broken. In production this MUST be set explicitly — the API
# refuses to boot otherwise (see assertCorsConfigured() in
# apps/api/src/index.ts) rather than falling back to reflecting any
# requesting Origin.
CORS_ALLOWED_ORIGINS=

# Operational alerts. Production startup requires a selected, authenticated
# HTTPS webhook receiver; leave values blank in local development to keep
# alert delivery disabled. Do not put real values in this example file.
OPERATIONAL_ALERTS_ENABLED=
OPERATIONAL_ALERTS_PROVIDER=webhook
OPERATIONAL_ALERTS_WEBHOOK_URL=
OPERATIONAL_ALERTS_TOKEN=
# Optional in-process cooldown (1-86400 seconds; defaults to 300).
OPERATIONAL_ALERTS_COOLDOWN_SECONDS=300
# Test dispatch has no route and requires this separate explicit opt-in.
OPERATIONAL_ALERTS_ALLOW_TEST=false

# Legal active-artifact control. These are engineering integrity inputs, not
# evidence of legal review or approval. Production rejects missing paths/hashes,
# hash mismatches, and artifacts retaining the DRAFT — LEGAL REVIEW REQUIRED marker.
# Keep blank until an assigned authority has separately approved non-draft artifacts.
LEGAL_DOCUMENTS_APPROVED=
APPROVED_TERMS_ARTIFACT_PATH=
APPROVED_TERMS_SHA256=
APPROVED_PRIVACY_ARTIFACT_PATH=
APPROVED_PRIVACY_SHA256=

# Communications webhook ingress is fail-closed. Both values are required to
# receive callbacks; leave disabled until a secret is provisioned. Signature
# validation alone is not durable byte-ingestion/checksum/version proof.
COMMUNICATIONS_WEBHOOK_INGRESS_ENABLED=false
COMMUNICATIONS_WEBHOOK_SECRET=

# AI (Contextual AI Architecture / Agent Engine Copilot)
# Provider abstraction mirrors AML/e-sign/payments above: mock is the safe default
# everywhere until a real key is supplied via Replit Secrets (never commit the key).
AI_PROVIDER=mock                    # mock | anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-5
AI_TEMPERATURE=0.2
AI_MAX_OUTPUT_TOKENS=1024
AI_TIMEOUT_MS=20000
AI_RETRY_LIMIT=2
AI_FALLBACK_PROVIDER=mock           # provider to use if the primary provider errors
# Master switch + per-role flags (services/ai/featureFlags.ts). All default on for
# Copilot (read-only, Level 0) and off for every role that has no real implementation
# yet (Proactive Intelligence, Business Coach, Workflow AI, Pit Crew AI).
AI_ENABLED=true
AI_COPILOT_ENABLED=true
AI_PROACTIVE_INTELLIGENCE_ENABLED=false
AI_BUSINESS_COACH_ENABLED=false
AI_WORKFLOW_AI_ENABLED=false
AI_PITCREW_AI_ENABLED=false
